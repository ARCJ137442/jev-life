# 依赖
node_modules/

# 编译产物（由 ./start.sh 生成，不入库）
dist/
dist-test/
# api/ 的编译产物（tsconfig.api.json 产出；normalize.test.ts 测的就是它）
dist-api/
public/js/

# 密钥 —— 绝不能进仓库
../local/
local/
*.key
*.sealed
*-secret-api-key*

# .env 一族 —— 同上，属于「密钥」一类。
# ⚠ 如实说明：**当前不可触发** —— 本仓没有任何 .env，没有 dotenv 依赖，
# 文档也没让人建一个。所以这是纵深防御，不是补一个已经漏了的口子。
# 之所以仍然加上：本仓已经吃过一次「写了规则但规则空转」的亏（上面那两条
# `../local/` 就永远匹配不到任何东西 —— gitignore 逃不出仓库根）。与其等
# 有人照着某篇教程建了 .env 再补，不如现在写一条**实测能命中**的：
#   git check-ignore -v .env   →   命中 `.env` 这一行
.env
.env.*

# git 自身的目录 —— 绝不能被提交
# 真实教训（来自 jev-2048）：.git.backup 曾不在忽略列表里，一次 git add -A
# 把整个旧 .git 提交了进去。里面的对象是 zlib 压缩的，明文正则扫描**抓不到**，
# 但任何人解压就能还原出密钥。
.git/
.git.backup/
.git*/
#
# ⚠ 上面那条 `.git*/` 用的是宽匹配（本意是兜住 `.git.backup` 的各种变体），
# 而它**也会匹配 `.github/`** —— 于是 `git add .github` 会被挡下来。
#
# 这个坑在 jev-2048 没有暴露：它的 workflow 在 `.git*/` 写进来**之前**
# 就已经被跟踪了（已跟踪的文件不受 .gitignore 影响）。**新仓库是白手起家，
# 第一次 add 就会撞上**，症状是 CI 与部署配置根本进不了库。
#
# 处理方式是**保留宽匹配 + 加一条否定**，而不是把 `.git*/` 改精确 ——
# 这条规则的存在理由是一次真实的泄漏事故，为省一条否定去削弱它不划算。
!.github/
*.pack
*.idx

# 本地验证时的克隆残留
clone-check/
*-check/

# 编辑器 / 系统
.DS_Store
.vscode/
.idea/
*.log
